# PLANNING PLACEHOLDERS ONLY. Never load this file as-is.
# Staging gets its own host/schema/key/cookie/prefix. No dev secrets.
APP_NAME=VulnLab
APP_ENV=production
APP_KEY=REPLACE_WITH_APPROVED_DATASET_KEY
APP_DEBUG=false
APP_URL=https://learn.example.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_DEDICATED_SCHEMA
DB_USERNAME=REPLACE_WITH_RUNTIME_USER
DB_PASSWORD=SET_PRIVATELY_OUTSIDE_GIT
DB_URL=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=__Host-vulnlab_beta_session
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
CACHE_PREFIX=vulnlab_beta_
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=array
LABS_ENABLED=false
LAB_RUNNER_URL=
LAB_RUNNER_TOKEN=
VITE_APP_NAME=VulnLab
# Trusted proxies/hosts, Access JWT and closed enrollment still need code work.
# These are not implemented by adding imaginary environment flags.

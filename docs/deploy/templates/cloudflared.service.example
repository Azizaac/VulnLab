# INERT PROPOSAL. Replace paths/user/credential and verify systemd/cloudflared versions.
# One unit/token per environment. Never pass the token value as an argument.
[Unit]
Description=VulnLab private-beta Cloudflare connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_CONNECTOR_USER
Group=REPLACE_CONNECTOR_GROUP
LoadCredential=tunnel-token:/PRIVATE/REPLACE_ENVIRONMENT/tunnel-token
ExecStart=/CONFIRMED/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20242 run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
CPUQuota=50%
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
